# Production Server Environment Configuration

# Application Settings
APP_NAME=BaiKaoTong AI Writing Platform
APP_VERSION=1.0.0
NODE_ENV=production
FLASK_ENV=production
DEBUG=false

# Server Configuration
HOST=0.0.0.0
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database Configuration
DB_TYPE=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_NAME=baikao_db
DB_USER=baikao_user
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# AI API Configuration
DOUBAO_API_KEY=CHANGE_THIS_API_KEY
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3

# Security Settings
SECRET_KEY=CHANGE_THIS_VERY_SECURE_SECRET_KEY
JWT_SECRET_KEY=CHANGE_THIS_JWT_SECRET_KEY
CORS_ORIGINS=https://yourdomain.com

# File Upload Settings
UPLOAD_FOLDER=/app/uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=txt,doc,docx,pdf,md

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/app/logs/production.log
LOG_MAX_BYTES=104857600  # 100MB
LOG_BACKUP_COUNT=10

# SSL Configuration
SSL_CERT_PATH=/etc/ssl/certs/server.crt
SSL_KEY_PATH=/etc/ssl/private/server.key

# Performance Settings
WORKERS=4
THREADS=2
TIMEOUT=300

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups