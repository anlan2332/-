# Local Development Environment Configuration

# Application Settings
APP_NAME=BaiKaoTong AI Writing Platform (Local)
APP_VERSION=1.0.0
NODE_ENV=development
FLASK_ENV=development
DEBUG=true

# Server Configuration
HOST=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database Configuration (SQLite for local development)
DB_TYPE=sqlite
DB_PATH=data/local.db

# Redis Configuration (optional for local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI API Configuration
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3

# Security Settings
SECRET_KEY=local_development_secret_key_not_for_production
JWT_SECRET_KEY=local_jwt_secret_key_not_for_production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS=txt,doc,docx,pdf,md

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FILE=logs/local.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=3

# Local Development Features
HOT_RELOAD=true
AUTO_MIGRATE=true